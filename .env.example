# Tu usuario de la empresa (LDAP). Donde ponga {usuario} se cambia por este.
# Vacío = el usuario de este Linux
LDAP_USER=tu_usuario

# Woffu. Si la contraseña lleva símbolos (#, $, espacios…), ponla entre comillas dobles
WOFFU_URL=https://tu_empresa.woffu.com
WOFFU_EMAIL=tu_email@empresa.com
WOFFU_PASSWORD="tu_password"
WOFFU_HOURS=7

# Aviso de comida
LUNCH_TIME=13:00               # hora a la que vas a comer
LUNCH_REMINDER_MINUTES=10      # minutos de antelación del aviso

# VPN — 1) interfaz del túnel (OpenFortiVPN usa ppp0; vacío = no mirarla).
#    Si no está pero las máquinas de abajo responden, estás en la oficina (no hace falta VPN)
VPN_INTERFACE=ppp0
# VPN — 2) máquinas internas que se prueban por SSH (sin login).
# Se da por caída solo si fallan todas.
# Vacío = solo se mira la interfaz (y Pingu no puede saber si estás en la oficina)
VPN_CHECK_HOSTS=servidor1.empresa.com:22,servidor2.empresa.com:22

# Tamaño del pingüino en píxeles (200 = tamaño original)
PENGUIN_SIZE=100

# Minutos que se esconde en la barra de arriba con doble click
HIDE_MINUTES=30

# Jornada intensiva (automática del 21-jun al 15-sep; fuera de esas fechas, desde el menú)
WOFFU_HOURS_INTENSIVA=6.5

# Recordatorios de fichaje (solo laborables)
RECORDATORIO_ENTRADA=10:00      # si a esta hora no has fichado entrada, aviso
RECORDATORIO_SALIDA=18:30       # si a esta hora sigues dentro, aviso
RECORDATORIO_SALIDA_FIN=21:00   # deja de mirar a partir de aquí

# Ausencias del equipo (iCal de Woffu) — opcional
WOFFU_ICAL_URL=

# Calendario de reuniones (SOGo, va por VPN) — opcional
# Usuario: LDAP_USER (pon SOGO_USER solo si fuera otro distinto)
SOGO_PASSWORD=
# Uno o varios calendarios separados por comas (se juntan sus reuniones).
# El tuyo: https://calendar.empresa.com/SOGo/dav/{usuario}/Calendar/personal/
SOGO_CALENDAR_URL=
REUNION_AVISO_MIN=10            # minutos de antelación del aviso

# Rocket.Chat — avisos de mensajes directos (opcional)
ROCKET_CHAT_URL=
ROCKET_CHAT_APP_ID=
ROCKET_CHAT_APP_SECRET=

# Resumen del día (laborables, la primera vez que estás delante del ordenador)
RESUMEN_DESDE=07:00
RESUMEN_HASTA=15:00

# Pausas: aviso tras N min de uso seguido; estar M min sin tocar nada cuenta como pausa
PAUSA_CADA_MIN=45
PAUSA_IDLE_MIN=5

# Código 2FA (como el alias my2fa): fichero con el secreto TOTP en base32.
# Vacío = sin opción de 2FA en el menú. Necesita oathtool (sudo apt install oathtool)
TOTP_SECRET_FILE=

# Comando para conectar la VPN: "Conectar VPN" lo abre en una terminal y ahí escribes
# las contraseñas (vacío = sin opción de conectar)
VPN_CONNECT_CMD=sudo openfortivpn gw.example.com:443 -u {usuario}
